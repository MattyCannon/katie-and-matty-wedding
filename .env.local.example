# RSVP → Google Sheets credentials.
# Copy this file to ".env.local" (git-ignored) and fill in the values.
# In Vercel, add the same three as Environment Variables.
# See README → "RSVP / Google Sheets setup" for how to obtain them.

# The service account's client_email (…@….iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The service account's private_key. Keep the surrounding quotes and the
# literal \n escapes exactly as they appear in the downloaded JSON key.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The Sheet id — the long string in the Sheet URL between /d/ and /edit.
# Current RSVP sheet (guest list lives on the tab named "Guest List"):
GOOGLE_SHEET_ID=1jF6TM0S_0rACFfV-I9XkC6LEQGlOh1uGCZUVBQf9Fe8


# --- Spotify "Request a Song" (see README → "Spotify song requests setup") ---
# From your Spotify app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Obtained once by running: node scripts/spotify-auth.mjs
SPOTIFY_REFRESH_TOKEN=
# The playlist id — from the playlist's Share link / URL after /playlist/
SPOTIFY_PLAYLIST_ID=
